yarn-error.log*
pnpm-debug.log*
coverage/
*.lcov

# Runtime and temporary data
pids/
*.pid
*.seed
*.pid.lock
.tmp/
.temp/
tools/test/tmp/
# IWSDK dev state, including the local HTTPS certificate and key
.iwsdk/

# Python and Blender leftovers
__pycache__/
*.py[cod]
.venv/
venv/
*.blend1

# MCP and agent configs generated per machine (absolute local paths)
.mcp.json
.cursor/mcp.json
.vscode/mcp.json
.codex/config.toml
opencode.json
.claude/settings.local.json

# NVIDIA's WebRTC streaming library, fetched for local use by tools/isaac/fetch-streaming-library.mjs (NVIDIA licence: never commit or deploy)
tools/isaac/vendor/

# Dev-only models and test photos (licence unclear; never deploy)
public/models/dev-only/

# Policies trained locally from the player's own room (Duck Lab XR); never deploy
public/policies/incoming/

# Internal design notes and plans (kept local, not published)
docs/

# Recordings, screenshots, telemetry, datasets and test output
artifacts/
# Scenario packs hold a player's room scan: never commit one, wherever it lands
*.scenario.json


# Vercel project link (vercel link)
.vercel/
