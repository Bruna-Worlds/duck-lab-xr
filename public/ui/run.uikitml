<!--
  Duck Lab XR scoreboard: title, run state, time, score, pickups, the combo
  line and the result line; on the 2D page also the duck's mood line, the
  link to the open-source repository and a minimize button that folds it to
  its header. The playground picker, the
  toggles and (on the 2D page) the moves live in menu.uikitml, the headset's
  move bar in moves.uikitml and the duck's camera in robot.uikitml. Ink card, cream text, candy accents; Bebas Neue (SIL OFL,
  public/fonts/BebasNeue-OFL.txt) for the big words, Nunito for the rest.
  Element ids are read by src/run-panel.ts. Keep copy in plain ASCII.
-->
<style>
  @font-face { font-family: bebas; src: url("../fonts/BebasNeue-Regular.ttf"); font-weight: 400; }

  .card { flex-direction: column; width: 470px; padding-top: 16px; padding-bottom: 14px; padding-left: 18px; padding-right: 18px; gap: 10px; background-color: #0f1020; border-radius: 28px; border-width: 2px; border-color: rgba(255, 207, 63, 0.4); font-family: nunito; }

  .header { flex-direction: row; justify-content: space-between; align-items: flex-start; }
  .brand { flex-direction: column; gap: 4px; }
  .sticker-shadow { background-color: #ffcf3f; border-radius: 12px; padding-right: 5px; padding-bottom: 5px; }
  .sticker { background-color: #1c1d36; border-radius: 12px; border-width: 2px; border-color: #ffcf3f; padding-left: 12px; padding-right: 12px; padding-top: 3px; padding-bottom: 1px; }
  .title { font-family: bebas; font-size: 34px; color: #ffcf3f; letter-spacing: 1px; line-height: 1; }
  .subtitle { font-size: 12px; font-weight: 700; color: rgba(255, 244, 220, 0.6); padding-left: 2px; }
  .side { flex-direction: column; align-items: flex-end; gap: 6px; }
  .pill { font-family: bebas; font-size: 17px; letter-spacing: 1px; color: #0f1020; background-color: #6fb7ff; border-radius: 999px; padding-left: 14px; padding-right: 14px; padding-top: 6px; padding-bottom: 4px; }
  .menu { font-family: bebas; font-size: 14px; letter-spacing: 1px; color: #fff4dc; background-color: rgba(255, 244, 220, 0.08); border-width: 2px; border-color: rgba(255, 244, 220, 0.25); border-radius: 999px; padding-left: 12px; padding-right: 12px; padding-top: 5px; padding-bottom: 3px; cursor: pointer; }
  .menu:hover { background-color: rgba(255, 244, 220, 0.18); }
  .side-row { flex-direction: row; gap: 6px; align-items: center; }
  .fold { width: 26px; height: 26px; border-radius: 13px; align-items: center; justify-content: center; background-color: rgba(255, 244, 220, 0.08); border-width: 1px; border-color: rgba(255, 244, 220, 0.25); cursor: pointer; }
  .fold:hover { background-color: rgba(255, 244, 220, 0.2); }
  .glyph { width: 14px; height: 14px; color: #fff4dc; }
  .body { flex-direction: column; gap: 10px; }
  .mood-row { flex-direction: row; align-items: center; gap: 8px; }
  .dot { width: 8px; height: 8px; border-radius: 4px; background-color: #ffcf3f; }
  .mood { font-size: 13px; font-weight: 700; color: rgba(255, 244, 220, 0.85); }
  .github { font-family: bebas; font-size: 15px; letter-spacing: 1px; color: #0f1020; background-color: #ffcf3f; border-radius: 999px; padding-left: 12px; padding-right: 12px; padding-top: 5px; padding-bottom: 3px; cursor: pointer; margin-top: 2px; }
  .github:hover { background-color: #ffe07a; }

  .stats { flex-direction: row; gap: 10px; }
  .tile { flex-direction: column; gap: 0px; background-color: #1c1d36; border-radius: 18px; border-width: 1px; border-color: rgba(255, 244, 220, 0.1); padding-left: 14px; padding-right: 14px; padding-top: 8px; padding-bottom: 8px; width: 128px; }
  .tile-wide { width: 160px; justify-content: center; gap: 2px; }
  .label { font-family: bebas; font-size: 12px; letter-spacing: 1px; color: rgba(255, 244, 220, 0.55); }
  .value { font-family: bebas; font-size: 38px; color: #fff4dc; line-height: 1; }
  .score { color: #ffcf3f; }
  .item { font-size: 13px; font-weight: 700; color: #fff4dc; }

  .combo { font-family: bebas; font-size: 20px; letter-spacing: 1px; color: #ff7a45; height: 22px; }
  .hint { font-size: 13px; font-weight: 600; color: rgba(255, 244, 220, 0.75); }
</style>
<div class="card">
  <div class="header">
    <div class="brand">
      <div class="sticker-shadow"><div class="sticker"><div class="title">DUCK LAB XR</div></div></div>
      <div id="run-subtitle" class="subtitle">Living room course</div>
      <div id="run-github" class="github" style="display: none">OPEN SOURCE ON GITHUB</div>
    </div>
    <div class="side">
      <div id="run-state" class="pill">WALK TO START</div>
      <div class="side-row">
        <div id="menu-button" class="menu" style="display: none">MENU</div>
        <div id="run-min" class="fold" style="display: none"><Minus class="glyph"></Minus></div>
        <div id="run-expand" class="fold" style="display: none"><ChevronDown class="glyph"></ChevronDown></div>
      </div>
    </div>
  </div>
  <div id="run-body" class="body">
  <div id="run-mood-row" class="mood-row" style="display: none">
    <div class="dot"></div>
    <div id="run-mood" class="mood">Waking up the duck...</div>
  </div>
  <div class="stats">
    <div class="tile">
      <div class="label">TIME</div>
      <div id="run-time" class="value">0:00.0</div>
    </div>
    <div class="tile">
      <div class="label">SCORE</div>
      <div id="run-score" class="value score">0</div>
    </div>
    <div class="tile tile-wide">
      <div id="item-crumbs" class="item">Crumbs 0/0</div>
      <div id="item-gates" class="item">Gates 0/0</div>
      <div id="item-goal" class="item">Goal 0/0</div>
    </div>
  </div>
  <div id="run-combo" class="combo"> </div>
  <div id="run-result" class="hint">Weave the books, pass the gates, kick the ball in the goal, reach the flag.</div>
  </div>
</div>
