{
  "name": "robot-app",
  "version": "0.1.0",
  "description": "Duck Lab XR: a mixed-reality game and training lab for the Microduck robot, on Meta Quest (IWSDK, MuJoCo, ONNX)",
  "license": "Apache-2.0",
  "author": "BRUNA GOODS LLC <dev@bruna.world>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bruna-Worlds/duck-lab-xr.git"
  },
  "homepage": "https://github.com/Bruna-Worlds/duck-lab-xr#readme",
  "bugs": {
    "url": "https://github.com/Bruna-Worlds/duck-lab-xr/issues"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "iwsdk dev restart --open --foreground",
    "dev:runtime": "vite",
    "dev:down": "iwsdk dev down",
    "dev:status": "iwsdk dev status",
    "reference:status": "iwsdk reference status",
    "reference:warmup": "iwsdk reference warmup",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview",
    "lab": "node tools/lab/server.mjs",
    "finetune": "node tools/train/finetune.mjs",
    "lab:open": "node tools/lab/server.mjs --open"
  },
  "dependencies": {
    "@iwsdk/core": "1.1.0-rc.1",
    "@mujoco/mujoco": "3.11.0",
    "@pmndrs/uikit": "^1.0.74",
    "@pmndrs/uikit-horizon": "^1.0.74",
    "@pmndrs/uikit-lucide": "^1.0.74",
    "onnxruntime-web": "1.27.0",
    "three": "npm:super-three@0.185.0",
    "trystero": "^0.25.4"
  },
  "devDependencies": {
    "@huggingface/hub": "2.17.5",
    "@iwsdk/cli": "1.1.0-rc.1",
    "@iwsdk/reference": "1.1.0-rc.1",
    "@iwsdk/vite-plugin-dev": "1.1.0-rc.1",
    "@meta-quest/metavr": "^1.8.1",
    "@types/three": "^0.185.0",
    "onnxruntime-node": "1.21.0",
    "protobufjs": "7.6.6",
    "typescript": "^5.5.0",
    "vite": "^7.1.4"
  },
  "overrides": {
    "sharp": "0.35.4",
    "three": "npm:super-three@0.185.0"
  },
  "engines": {
    "node": ">=20.19.0 <21.0.0-0 || >=22.12.0 <23.0.0-0 || >=24.0.0"
  }
}
